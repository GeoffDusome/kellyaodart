---
import "../assets/css/reset.css";
import "../assets/css/variables.css";
import "../assets/css/typography.css";
import "../assets/css/utilities.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SEO, { type SEOData } from "../components/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  seo?: SEOData;
}

const {
  title = "Kelly AOD Art",
  description = "Original paintings and art prints by Kelly AOD.",
  seo,
} = Astro.props;

const seoData: SEOData = {
  ...seo,
  description: seo?.description ?? description,
  canonicalUrl:
    seo?.canonicalUrl ??
    (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined),
  ogTitle: seo?.ogTitle ?? title,
  ogType: seo?.ogType ?? "website",
  twitterCard: seo?.twitterCard ?? "summary",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO seo={seoData} />
    <title>{title}</title>
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style>
  .site-body {
    display: flex;
    flex-direction: column;
  }
</style>
