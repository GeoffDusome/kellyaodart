---
import { Image } from "astro:assets";

import Button from "@components/Button.astro";
import NewBadge from "@components/NewBadge.astro";
import ProductPrice from "@components/ProductPrice.astro";
import type { Product } from "@lib/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="product-card">
  {product.images[0] && (
    <div class="product-card__media" transition:name={"product-image-" + product.id}>
      <Image src={product.images[0].url} alt={product.images[0].alt} inferSize={true} />
      {product.isNew && <NewBadge />}
    </div>
  )}
  <div class="product-card__content">
    <h2 class="product-card__title" transition:name={"product-title-" + product.id}>
      {product.name}
    </h2>
    {product.price && (
      <p class="product-card__cost" transition:name={"product-price-" + product.id}>
        {product.variations.length > 1 &&
          `Available in ${product.variations.length} sizes starting at `}
        <ProductPrice price={product.price} regularPrice={product.regularPrice} />
      </p>
    )}
    {product.description && (
      <p class="product-card__description" transition:name={"product-description-" + product.id}>
        {product.description}
      </p>
    )}
    <div class="product-card__action">
      <Button as="span" variant="brush">
        View more details
      </Button>
    </div>
  </div>
  <a
    href={`/products/${product.collection}/${product.slug}`}
    class="product-card__link-overlay"
    aria-label=`Read more about ${product.name}`
  ></a>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-20);
    height: 100%;
    position: relative;

    &:is(:hover, :focus-within) {
      .product-card__media img {
        transform: scale(1.05);
      }
      .brush-link::after {
        clip-path: inset(0);
      }
    }
  }

  .product-card__media {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.15s ease-out;
    }
  }

  .product-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacer-10);
  }

  .product-card__title {
    font-size: var(--font-size-20);
  }

  .product-card__cost {
    font-weight: var(--font-weight-bold);
  }

  .product-card__description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .product-card__action {
    margin-top: auto;
  }

  .product-card__link-overlay {
    display: block;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
  }
</style>
