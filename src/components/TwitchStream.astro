---
import Button from "./Button.astro";

const channel = import.meta.env.TWITCH_CHANNEL;
---

<section class="twitch full-width" aria-label="Twitch stream" data-twitch-stream>
  <div class="twitch__inner grid-width">
    <h2 class="twitch__title">Live from the studio</h2>
    <p class="twitch__status" role="status" data-status>
      Checking Twitch live status...
    </p>
    <div class="twitch__embed">
      <iframe
        title="Kelly AOD Art on Twitch"
        width="1920"
        height="1080"
        allowfullscreen
        hidden
      ></iframe>
    </div>
    <div class="twitch__cta">
      <Button
        as="a"
        variant="paper"
        data-channel-link
        href={channel ? `https://www.twitch.tv/${encodeURIComponent(channel)}` : undefined}
        hidden={!channel}
      >
        Watch or follow on Twitch
      </Button>
    </div>
  </div>
</section>

<script>
  import type { TwitchStatus } from "../lib/twitch";

  for (const section of document.querySelectorAll<HTMLElement>("[data-twitch-stream]")) {
    const status = section.querySelector<HTMLElement>("[data-status]")!;
    const player = section.querySelector("iframe")!;
    const link = section.querySelector<HTMLAnchorElement>("[data-channel-link]")!;

    async function checkStatus() {
      try {
        const response = await fetch("/api/twitch-live", {
          signal: AbortSignal.timeout(60_000),
        });
        if (!response.ok) throw new Error(`Twitch status request failed (${response.status}).`);
        const data: TwitchStatus = await response.json();
        link.href = `https://www.twitch.tv/${encodeURIComponent(data.channel)}`;
        link.hidden = false;
        status.textContent = data.live
          ? `Live now: ${data.title}`
          : data.videoId
            ? `Latest broadcast: ${data.title}`
            : "The studio stream is offline and no past broadcasts are available.";

        if (data.live || data.videoId) {
          const url = new URL("https://player.twitch.tv/");
          url.search = new URLSearchParams({
            ...(data.live ? { channel: data.channel } : { video: `v${data.videoId}` }),
            parent: window.location.hostname,
            autoplay: "false",
            muted: "true",
          }).toString();
          player.src = url.href;
          player.hidden = false;
        } else {
          player.hidden = true;
          player.removeAttribute("src");
        }
      } catch (error) {
        console.error("[twitch-stream]", error);
        status.textContent = "Unable to load a Twitch video. Please try Twitch directly.";
        player.hidden = true;
        player.removeAttribute("src");
      }
    }

    void checkStatus();
  }
</script>

<style>
  .twitch {
    padding: var(--spacer-70);
  }

  .twitch__title {
    font-weight: var(--font-weight-regular);
  }

  .twitch__status {
    margin-top: var(--spacer-20);
  }

  .twitch__embed {
    margin-top: var(--spacer-30);
    width: 100%;
    aspect-ratio: 16 / 9;

    iframe {
      width: 100%;
      height: 100%;
      border: 0;
      object-fit: cover;
    }
  }

  .twitch__cta {
    margin-top: var(--spacer-30);
  }

  /* Twitch requires at least 400px of player width; smaller screens use the link. */
  @media (max-width: 28rem) {
    iframe {
      display: none;
    }
  }
</style>
