---
import Button from "./Button.astro";

const navigationItems = [
  {
    href: "/about",
    label: "About",
  },
  {
    href: "/products/originals",
    label: "Originals",
  },
  {
    href: "/products/originals",
    label: "Prints",
  },
  {
    href: "/live",
    label: "Live",
  },
];
---

<header class="site-header">
  <div class="site-header__inner grid-width">
    <Button as="a" variant="link" href="/" class="site-header__wordmark">
      Kelly O'Neill-Dusome Fine Art
    </Button>
    <nav class="site-header__navigation" aria-label="Main navigation">
      <ul class="site-header__navgation-list">
        {navigationItems.map((item) => (
          <li class="site-header__navigation-list-item">
            <Button as="a" variant="link" href={item.href} class="site-header__navigation-link">
              {item.label}
            </Button>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    padding: var(--spacer-20) var(--grid-margin);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__wordmark {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__navgation-list {
    display: flex;
    align-items: center;
    gap: var(--spacer-40);
  }
</style>
