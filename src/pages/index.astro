---
import SiteLayout from "../layouts/SiteLayout.astro";
import TwitchStream from "../components/TwitchStream.astro";
import Hero from "../components/Hero.astro";
import Boxes from "../components/Boxes.astro";
---

<SiteLayout>
  <main class="home" id="main-content">
    <Hero
      title="Original paintings and reproductions"
      description="Traditional realism waterscape and landscape acrylic paintings."
      button={{
        href: "/about",
        label: "About me",
      }}
    />
    <Boxes
      boxes={[
        {
          icon: "wall-art",
          title: "Originals",
          description: "Shop all of my original acrylic paintings.",
          button: {
            href: "/products/originals",
            label: "Explore my originals",
          },
        },
        {
          icon: "image",
          title: "Reproductions",
          description: "Shop reproductions of my original paintings. Great for gifts!",
          button: {
            href: "/products/reproductions",
            label: "Explore my reproductions",
          },
        },
      ]}
    />
    <TwitchStream />
  </main>
</SiteLayout>
