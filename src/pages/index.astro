---
import SiteLayout from "../layouts/SiteLayout.astro";
import TwitchStream from "../components/TwitchStream.astro";
---

<SiteLayout>
  <main class="home" id="main-content">
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Kelly AOD Art</p>
      <h1 id="page-title">Original paintings and art prints.</h1>
      <p>Explore original artwork and prints by Kelly AOD.</p>
      <a class="paper-link" href="/about">About me</a>
    </section>
    <section class="collections" aria-label="Collections">
      <article class="collection" id="originals">
        <h2>Originals</h2>
        <p>Original paintings</p>
        <a class="brush-link" href="/products/originals">Explore originals</a>
      </article>
      <article class="collection" id="prints">
        <h2>Prints</h2>
        <p>Art prints</p>
        <a class="brush-link" href="/products/prints">Explore prints</a>
      </article>
    </section>
    <TwitchStream />
  </main>
</SiteLayout>

<style>
  .home {
    width: calc(100% - var(--space-page) - var(--space-page));
    max-width: 80rem;
    margin-inline: auto;
  }

  .intro {
    max-width: 56rem;
    padding-block: clamp(5rem, 14vw, 12rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.5rem);
    letter-spacing: -0.045em;
  }

  .intro > p:not(.eyebrow) {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
  }

  .collections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  .collection {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-line);
  }

  .collection h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .collection p {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
  }

  .collection > a {
    align-self: flex-start;
    margin-top: 1.5rem;
  }

  .intro > a {
    margin-top: 1.5rem;
  }

  @media (max-width: 38rem) {
    .collections {
      grid-template-columns: 1fr;
    }
  }
</style>
