---
import ProductArchive from "../../components/ProductArchive.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { loadProducts } from "../../lib/load-products";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const products = (await loadProducts()).filter(
  (product) => product.collection === "prints" && product.inStock,
);
---

<SiteLayout title="Prints | Kelly AOD Art">
  <ProductArchive title="Prints" products={products} />
</SiteLayout>
