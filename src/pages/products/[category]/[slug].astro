---
import { Image } from "astro:assets";
import {
  Swiper,
  SwiperButtonNext,
  SwiperButtonPrev,
  SwiperPagination,
  SwiperSlide,
  SwiperWrapper,
} from "astro-swiper";
import SiteLayout from "@layouts/SiteLayout.astro";
import Button from "@components/Button.astro";
import NewBadge from "@components/NewBadge.astro";
import ProductPrice from "@components/ProductPrice.astro";
import { loadProducts } from "@lib/load-products";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const { category, slug } = Astro.params;
const product =
  category === "originals" || category === "reproductions"
    ? (await loadProducts()).find((item) => item.collection === category && item.slug === slug)
    : undefined;
if (!product) Astro.response.status = 404;
const initialVariation =
  product?.variations.find((variation) => variation.quantity > 0 && variation.price) ??
  product?.variations[0];
---

<SiteLayout
  title={`${product?.name ?? "Product not found"} | Kelly AOD Art`}
  description={product?.description}
>
  <main id="main-content">
    {product ? (
      <article class="product-header">
        <div class="product-header__inner grid-width">
          <div class="product-header__media">
            {product.isNew && <NewBadge />}
            {product.images.length > 1 ? (
              <>
                <Swiper
                  uniqueClass="product-header__carousel"
                  linkToThumbUniqueClass="product-header__thumb-carousel"
                  transition:name={"product-image-" + product.id}
                  options={{
                    navigation: {
                      nextEl: ".swiper-button-next",
                      prevEl: ".swiper-button-prev",
                    },
                    pagination: { el: ".swiper-pagination", clickable: true },
                  }}
                >
                  <SwiperWrapper>
                    {product.images.map((image) => (
                      <SwiperSlide>
                        <Image src={image.url} alt={image.alt} inferSize={true} />
                      </SwiperSlide>
                    ))}
                  </SwiperWrapper>
                  <SwiperButtonPrev role="button" tabindex={0} aria-label="Previous image" />
                  <SwiperButtonNext role="button" tabindex={0} aria-label="Next image" />
                  <SwiperPagination />
                </Swiper>
                <Swiper
                  uniqueClass="product-header__thumb-carousel"
                  options={{
                    slidesPerView: 4,
                    freeMode: true,
                    watchSlidesProgress: true,
                    spaceBetween: 20,
                  }}
                >
                  <SwiperWrapper>
                    {product.images.map((image) => (
                      <SwiperSlide>
                        <Image src={image.url} alt={image.alt} inferSize={true} />
                      </SwiperSlide>
                    ))}
                  </SwiperWrapper>
                </Swiper>
              </>
            ) : product.images[0] ? (
              <Image
                class="product-header__single-image"
                transition:name={"product-image-" + product.id}
                src={product.images[0].url}
                alt={product.images[0].alt}
                inferSize={true}
              />
            ) : null}
          </div>
          <div class="product-header__content">
            <span class="product-header__eyebrow">{product.collection}</span>
            <h1 transition:name={"product-title-" + product.id}>{product.name}</h1>
            <p transition:name={"product-description-" + product.id}>{product.description}</p>
            {product.orientation && <p>{product.orientation}</p>}
            {product.variations.length > 1 ? (
              <div class="product-header__info">
                <div class="product-header__size">
                  <label for="product-size-selector" class="product-header__size-selector-label">
                    Size
                  </label>
                  <select id="product-size-selector" class="product-header__size-selector">
                    {product.variations.map((variation) => (
                      <option
                        value={variation.id}
                        selected={variation.id === initialVariation?.id}
                        disabled={variation.quantity <= 0}
                      >
                        {variation.size}
                      </option>
                    ))}
                  </select>
                </div>
                {product.price && (
                  <p class="product-header__price">
                    {product.variations.map((variation) => (
                      <span
                        data-variation-price={variation.id}
                        hidden={variation.id !== initialVariation?.id}
                      >
                        {variation.price ? (
                          <ProductPrice
                            price={variation.price}
                            regularPrice={variation.regularPrice}
                          />
                        ) : (
                          "Price unavailable"
                        )}
                      </span>
                    ))}
                  </p>
                )}
                <div class="product-header__actions">
                  <Button as="button" variant="paper">
                    Add to Cart
                  </Button>
                </div>
              </div>
            ) : (
              <div class="product-header__info">
                {product.price && (
                  <p class="product-header__price" transition:name={"product-price-" + product.id}>
                    <ProductPrice price={product.price} regularPrice={product.regularPrice} />
                  </p>
                )}
                {product.inStock && product.variations[0].inventory[0].quantity > 1 && (
                  <div class="product-header__quantity">
                    <label for="quantity-selector" class="product-header__quantity-label">
                      Quantity
                    </label>
                    <div class="product-header__quantity-input-wrapper">
                      <input
                        type="number"
                        id="quantity-selector"
                        class="product-header__quantity-input"
                        value="1"
                        min="1"
                        max={product.variations[0].inventory[0].quantity}
                      />
                    </div>
                  </div>
                )}
                <div class="product-header__actions">
                  <Button as="button" variant="paper">
                    Add to Cart
                  </Button>
                </div>
              </div>
            )}
          </div>
        </div>
      </article>
    ) : (
      <>
        <h1>Product not found</h1>
        <p>This piece is no longer available at this address.</p>
        <a href="/products/originals">Browse originals</a>
        <a href="/products/reproductions">Browse reproductions</a>
      </>
    )}
  </main>
</SiteLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const selector = document.querySelector<HTMLSelectElement>("#product-size-selector");
    if (!selector) return;
    const updatePrice = () => {
      for (const price of document.querySelectorAll<HTMLElement>("[data-variation-price]")) {
        price.hidden = price.dataset.variationPrice !== selector.value;
      }
    };
    selector.onchange = updatePrice;
    updatePrice();
  });
</script>

<style>
  .product-header {
    padding: var(--spacer-70) 0;
  }

  .product-header__inner {
    display: grid;
    grid-template-columns: 40% 60%;
    gap: var(--spacer-60);
  }

  .product-header__media {
    position: relative;
    padding: var(--spacer-20);
    background-color: var(--color-muted);

    &:has(.product-header__single-image) {
      aspect-ratio: 1;
    }
  }

  .product-header__carousel {
    width: 100%;
  }

  .product-header__carousel .swiper-slide,
  .product-header__thumb-carousel .swiper-slide {
    display: flex;
    justify-content: center;
    height: auto;
    aspect-ratio: 1;

    & img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

  .product-header__thumb-carousel .swiper-slide {
    cursor: pointer;
  }

  .product-header__single-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-header__eyebrow {
    margin-bottom: var(--spacer-20);
    color: var(--color-muted);
    font-size: var(--font-size-05);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
