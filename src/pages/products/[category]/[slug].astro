---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { loadProducts } from "../../../lib/load-products";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const { category, slug } = Astro.params;
const product = category === "originals" || category === "prints"
  ? (await loadProducts()).find(
      (item) => item.collection === category && item.slug === slug,
    )
  : undefined;
if (!product) Astro.response.status = 404;
---

<SiteLayout
  title={`${product?.name ?? "Product not found"} | Kelly AOD Art`}
  description={product?.description}
>
  <main id="main-content">
    {product ? <article>
      <h1>{product.name}</h1>
      <p>{product.description}</p>
      <p>{product.collection}</p>
      {product.orientation && <p>{product.orientation}</p>}
      <ul>
        {
          product.images.map((image) => (
            <li>
              <img src={image.url} alt={image.alt} />
            </li>
          ))
        }
      </ul>
      <ul>
        {
          product.variations.map((variation) => (
            <li>
              <span>{variation.size ?? "One size"}</span>
              {variation.price && (
                <span>
                  {new Intl.NumberFormat("en-US", {
                    style: "currency",
                    currency: variation.price.currency,
                  }).format(variation.price.amount / 100)}
                </span>
              )}
              <span>{variation.quantity > 0 ? `${variation.quantity} in stock` : "Sold out"}</span>
            </li>
          ))
        }
      </ul>
    </article> : (
      <>
        <h1>Product not found</h1>
        <p>This piece is no longer available at this address.</p>
        <a href="/products/originals">Browse originals</a>
        <a href="/products/prints">Browse prints</a>
      </>
    )}
  </main>
</SiteLayout>
