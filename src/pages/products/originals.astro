---
import Hero from "@components/Hero.astro";
import ProductArchive from "@components/ProductArchive.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { loadProducts } from "@lib/load-products";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const products = (await loadProducts()).filter(
  (product) => product.collection === "originals" && product.inStock,
);
---

<SiteLayout title="Originals | Kelly AOD Art">
  <main id="main-content">
    <Hero
      eyebrow="Shop"
      title="Originals"
      description="Shop all of my one of a kind original acrylic paintings."
    />
    <ProductArchive products={products} />
  </main>
</SiteLayout>
