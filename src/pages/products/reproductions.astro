---
import Hero from "@components/Hero.astro";
import ProductArchive from "@components/ProductArchive.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { loadProducts } from "@lib/load-products";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const products = (await loadProducts()).filter(
  (product) => product.collection === "reproductions" && product.inStock,
);
---

<SiteLayout title="Reproductions | Kelly AOD Art">
  <main id="main-content">
    <Hero eyebrow="Shop" title="Reproductions" description="Shop all of my reproduction prints." />
    <ProductArchive products={products} />
  </main>
</SiteLayout>
